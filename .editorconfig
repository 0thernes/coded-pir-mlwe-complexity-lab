root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,c,h}]
indent_style = space
indent_size = 4

[*.{lean,json,yml,yaml,toml,md,tex,bib,mjs,esk}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.ps1]
end_of_line = crlf
