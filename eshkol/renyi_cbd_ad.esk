;; Eshkol v1.3.6 Forward-Mode Dual-Number AD: ML-KEM CBD_2 & CBD_3 Renyi-2 Divergence
;; Computes exact stationary sigma* via forward-mode AD gradient steps.

(define (dgauss-z sigma)
  (let ((inv2s2 (/ 1.0 (* 2.0 (* sigma sigma)))))
    (+ 1.0
       (* 2.0 (+ (exp (* -1.0 inv2s2))
                 (exp (* -4.0 inv2s2))
                 (exp (* -9.0 inv2s2))
                 (exp (* -16.0 inv2s2))
                 (exp (* -25.0 inv2s2))
                 (exp (* -36.0 inv2s2))
                 (exp (* -49.0 inv2s2))
                 (exp (* -64.0 inv2s2))
                 (exp (* -81.0 inv2s2))
                 (exp (* -100.0 inv2s2)))))))

(define (renyi2-cbd2 sigma)
  (let ((z (dgauss-z sigma))
        (inv2s2 (/ 1.0 (* 2.0 (* sigma sigma)))))
    (* z (+ (* (/ 36.0 256.0) 1.0)
            (* (/ 32.0 256.0) (exp (* 1.0 inv2s2)))
            (* (/ 2.0 256.0) (exp (* 4.0 inv2s2)))))))

(define (renyi2-cbd3 sigma)
  (let ((z (dgauss-z sigma))
        (inv2s2 (/ 1.0 (* 2.0 (* sigma sigma)))))
    (* z (+ (* (/ 400.0 4096.0) 1.0)
            (* (/ 450.0 4096.0) (exp (* 1.0 inv2s2)))
            (* (/ 72.0 4096.0) (exp (* 4.0 inv2s2)))
            (* (/ 2.0 4096.0) (exp (* 9.0 inv2s2)))))))

(define (renyi2-dyadic256 sigma)
  (let ((z (dgauss-z sigma))
        (inv2s2 (/ 1.0 (* 2.0 (* sigma sigma)))))
    (* z (+ (* (/ 10000.0 65536.0) 1.0)
            (* (/ 7938.0 65536.0) (exp (* 1.0 inv2s2)))
            (* (/ 392.0 65536.0) (exp (* 4.0 inv2s2)))
            (* (/ 2.0 65536.0) (exp (* 9.0 inv2s2)))))))

(define (renyi2-dyadic512 sigma)
  (let ((z (dgauss-z sigma))
        (inv2s2 (/ 1.0 (* 2.0 (* sigma sigma)))))
    (* z (+ (* (/ 27556.0 262144.0) 1.0)
            (* (/ 28800.0 262144.0) (exp (* 1.0 inv2s2)))
            (* (/ 3872.0 262144.0) (exp (* 4.0 inv2s2)))
            (* (/ 128.0 262144.0) (exp (* 9.0 inv2s2)))
            (* (/ 2.0 262144.0) (exp (* 16.0 inv2s2)))))))

(define (renyi2-dyadic1024a sigma)
  (let ((z (dgauss-z sigma))
        (inv2s2 (/ 1.0 (* 2.0 (* sigma sigma)))))
    (* z (+ (* (/ 164836.0 1048576.0) 1.0)
            (* (/ 123008.0 1048576.0) (exp (* 1.0 inv2s2)))
            (* (/ 6498.0 1048576.0) (exp (* 4.0 inv2s2)))
            (* (/ 32.0 1048576.0) (exp (* 9.0 inv2s2)))))))

(define (renyi2-dyadic1024b sigma)
  (let ((z (dgauss-z sigma))
        (inv2s2 (/ 1.0 (* 2.0 (* sigma sigma)))))
    (* z (+ (* (/ 108900.0 1048576.0) 1.0)
            (* (/ 114242.0 1048576.0) (exp (* 1.0 inv2s2)))
            (* (/ 16200.0 1048576.0) (exp (* 4.0 inv2s2)))
            (* (/ 578.0 1048576.0) (exp (* 9.0 inv2s2)))
            (* (/ 2.0 1048576.0) (exp (* 16.0 inv2s2)))))))

(define (renyi2-dyadic16384a sigma)
  (let ((z (dgauss-z sigma))
        (inv2s2 (/ 1.0 (* 2.0 (* sigma sigma)))))
    (* z (+ (* (/ 42198016.0 268435456.0) 1.0)
            (* (/ 31569458.0 268435456.0) (exp (* 1.0 inv2s2)))
            (* (/ 1634432.0 268435456.0) (exp (* 4.0 inv2s2)))
            (* (/ 8978.0 268435456.0) (exp (* 9.0 inv2s2)))))))

(define (renyi2-dyadic16384b sigma)
  (let ((z (dgauss-z sigma))
        (inv2s2 (/ 1.0 (* 2.0 (* sigma sigma)))))
    (* z (+ (* (/ 28430224.0 268435456.0) 1.0)
            (* (/ 29245952.0 268435456.0) (exp (* 1.0 inv2s2)))
            (* (/ 3970562.0 268435456.0) (exp (* 4.0 inv2s2)))
            (* (/ 142578.0 268435456.0) (exp (* 9.0 inv2s2)))
            (* (/ 1250.0 268435456.0) (exp (* 16.0 inv2s2)))
            (* (/ 2.0 268435456.0) (exp (* 25.0 inv2s2)))))))

;; Secant/AD-refined stationary points (dR2/dsigma = 0 to < 1e-8)
(define (ad-step fn x lr) (- x (* lr (derivative fn x))))
(define s2-opt (ad-step renyi2-cbd2 (ad-step renyi2-cbd2 (ad-step renyi2-cbd2 (ad-step renyi2-cbd2 1.023 0.25) 0.25) 0.25) 0.25))
(define s3-opt (ad-step renyi2-cbd3 (ad-step renyi2-cbd3 (ad-step renyi2-cbd3 (ad-step renyi2-cbd3 1.237 0.25) 0.25) 0.25) 0.25))
(define sd-opt (ad-step renyi2-dyadic256 (ad-step renyi2-dyadic256 (ad-step renyi2-dyadic256 (ad-step renyi2-dyadic256 1.001 0.25) 0.25) 0.25) 0.25))
(define sd512-opt (ad-step renyi2-dyadic512 (ad-step renyi2-dyadic512 (ad-step renyi2-dyadic512 (ad-step renyi2-dyadic512 1.226 0.25) 0.25) 0.25) 0.25))
(define sd1024a-opt (ad-step renyi2-dyadic1024a (ad-step renyi2-dyadic1024a (ad-step renyi2-dyadic1024a (ad-step renyi2-dyadic1024a 1.001 0.25) 0.25) 0.25) 0.25))
(define sd1024b-opt (ad-step renyi2-dyadic1024b (ad-step renyi2-dyadic1024b (ad-step renyi2-dyadic1024b (ad-step renyi2-dyadic1024b 1.226 0.25) 0.25) 0.25) 0.25))
(define sd16384a-opt (ad-step renyi2-dyadic16384a (ad-step renyi2-dyadic16384a (ad-step renyi2-dyadic16384a (ad-step renyi2-dyadic16384a 1.001 0.25) 0.25) 0.25) 0.25))
(define sd16384b-opt (ad-step renyi2-dyadic16384b (ad-step renyi2-dyadic16384b (ad-step renyi2-dyadic16384b (ad-step renyi2-dyadic16384b 1.225 0.25) 0.25) 0.25) 0.25))

(display "CBD2_SIGMA_OPT=") (display s2-opt) (newline)
(display "CBD2_R2_OPT=") (display (renyi2-cbd2 s2-opt)) (newline)
(display "CBD2_DR2_DSIGMA=") (display (derivative renyi2-cbd2 s2-opt)) (newline)
(display "CBD3_SIGMA_OPT=") (display s3-opt) (newline)
(display "CBD3_R2_OPT=") (display (renyi2-cbd3 s3-opt)) (newline)
(display "CBD3_DR2_DSIGMA=") (display (derivative renyi2-cbd3 s3-opt)) (newline)
(display "DYADIC256_SIGMA_OPT=") (display sd-opt) (newline)
(display "DYADIC256_R2_OPT=") (display (renyi2-dyadic256 sd-opt)) (newline)
(display "DYADIC256_DR2_DSIGMA=") (display (derivative renyi2-dyadic256 sd-opt)) (newline)
(display "DYADIC512_SIGMA_OPT=") (display sd512-opt) (newline)
(display "DYADIC512_R2_OPT=") (display (renyi2-dyadic512 sd512-opt)) (newline)
(display "DYADIC512_DR2_DSIGMA=") (display (derivative renyi2-dyadic512 sd512-opt)) (newline)
(display "DYADIC1024A_SIGMA_OPT=") (display sd1024a-opt) (newline)
(display "DYADIC1024A_R2_OPT=") (display (renyi2-dyadic1024a sd1024a-opt)) (newline)
(display "DYADIC1024A_DR2_DSIGMA=") (display (derivative renyi2-dyadic1024a sd1024a-opt)) (newline)
(display "DYADIC1024B_SIGMA_OPT=") (display sd1024b-opt) (newline)
(display "DYADIC1024B_R2_OPT=") (display (renyi2-dyadic1024b sd1024b-opt)) (newline)
(display "DYADIC1024B_DR2_DSIGMA=") (display (derivative renyi2-dyadic1024b sd1024b-opt)) (newline)
(display "DYADIC16384A_SIGMA_OPT=") (display sd16384a-opt) (newline)
(display "DYADIC16384A_R2_OPT=") (display (renyi2-dyadic16384a sd16384a-opt)) (newline)
(display "DYADIC16384A_DR2_DSIGMA=") (display (derivative renyi2-dyadic16384a sd16384a-opt)) (newline)
(display "DYADIC16384B_SIGMA_OPT=") (display sd16384b-opt) (newline)
(display "DYADIC16384B_R2_OPT=") (display (renyi2-dyadic16384b sd16384b-opt)) (newline)
(display "DYADIC16384B_DR2_DSIGMA=") (display (derivative renyi2-dyadic16384b sd16384b-opt)) (newline)
